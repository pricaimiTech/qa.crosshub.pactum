# Ambiente: prod — atenção redobrada, é o ambiente de produção.
# Copiar para ".env.prod" e preencher os valores.
# Preferir credenciais de uma conta de QA dedicada, nunca de um usuário real.

# URL base da API do CrossHub
BASE_URL=https://api.crosshub.example.com

# Credenciais usadas no preSetup (login que gera os tokens dos testes)
ADMIN_EMAIL=
ADMIN_PASSWORD=
TENANT_SLUG=

# Senha das contas descartáveis que o `preSetup` cria (pools de admins, segundo
# tenant, tenant vazio e tenants por caso). Mínimo de 12 caracteres. Em branco
# de propósito: o arquivo é versionado e o repositório é público. O `preSetup`
# redefine a senha de todas elas a cada execução, então basta escolher um valor.
POOL_PASSWORD=

# Fuso do tenant sob teste (IANA). A API devolve horários em UTC e as regras de
# agenda são cadastradas no horário local — sem isso, asserções de janela erram.
TENANT_TIMEZONE=America/Sao_Paulo

# Liga/desliga o log das requisições Pactum
LOG=false
