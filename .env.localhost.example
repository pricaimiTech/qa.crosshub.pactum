# Ambiente: localhost — API rodando na própria máquina.
# Copiar para ".env.localhost" e preencher os valores.
#
# Template. Todo valor de credencial fica em branco de propósito: o arquivo é
# versionado e o repositório é público, então o que for escrito aqui vale para
# sempre e para qualquer um. O `.env.localhost` de verdade está no `.gitignore`.

# URL base da API do CrossHub
BASE_URL=http://localhost:3001

# Credenciais usadas no preSetup (login que gera os tokens dos testes)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Tenant usado pela automação de API
TENANT_SLUG=
TENANT_NAME=
TENANT_EMAIL=
TENANT_PASSWORD=

# Senha das contas descartáveis que o `preSetup` cria (pools de admins, segundo
# tenant, tenant vazio e tenants por caso). Mínimo de 12 caracteres. Em branco
# de propósito: o arquivo é versionado e o repositório é público. O `preSetup`
# redefine a senha de todas elas a cada execução, então basta escolher um valor.
POOL_PASSWORD=

# Fuso do tenant sob teste (IANA). A API devolve horários em UTC e as regras de
# agenda são cadastradas no horário local — sem isso, asserções de janela erram.
TENANT_TIMEZONE=America/Sao_Paulo

# Liga/desliga o log das requisições Pactum
LOG=false

# --- Organização do plano Beta ---------------------------------------------
# Contraste com o TENANT_* acima, que usa o plano completo: esta tem só os
# cinco módulos do beta, e as rotas dos demais respondem 403 pelo
# `RequiresModuleGuard`. Criar pelo Super Admin: POST /admin/plans, depois
# POST /admin/tenants e POST /admin/tenants/{id}/admins.
BETA_TENANT_SLUG=clinica-beta
BETA_TENANT_NAME="Clinica Beta"
BETA_TENANT_EMAIL=recepcao@clinica-beta.com
BETA_TENANT_PASSWORD=defina-uma-senha-de-no-minimo-12-caracteres
BETA_PLAN_SLUG=beta-agenda
BETA_PLAN_MODULES=branding,banners,people,access_codes,appointments
