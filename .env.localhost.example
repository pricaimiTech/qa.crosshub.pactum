# Ambiente: localhost — API rodando na própria máquina.
# Copiar para ".env.localhost" e preencher os valores.

# URL base da API do CrossHub
BASE_URL=http://localhost:3001

# Credenciais usadas no preSetup (login que gera os tokens dos testes)
ADMIN_EMAIL=paraujocaimi@gmail.com
ADMIN_PASSWORD=Prica08121313

# tenant para testes de automacao de api
TENANT_SLUG='automacao-teste-de-api'
TENANT_NAME='Automação Teste de API'
TENANT_PASSWORD='8EByxV8pV4i!5yMT'
TENANT_EMAIL='ana-muniz@tuamaeaquelaursa.com'

# Fuso do tenant sob teste (IANA). A API devolve horários em UTC e as regras de
# agenda são cadastradas no horário local — sem isso, asserções de janela erram.
TENANT_TIMEZONE=America/Sao_Paulo

# Liga/desliga o log das requisições Pactum
LOG=false
